# Copy this file to android/key.properties and fill in your release keystore
# details. android/key.properties is git-ignored — never commit the real file
# or the .jks/.keystore it points to.
#
# Generate a keystore (once) with:
#   keytool -genkey -v -keystore ~/heralth-release.keystore -alias heralth \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# If this file is absent, release builds automatically fall back to debug
# signing so `flutter build apk/appbundle --release` still works for local
# testing and Firebase App Distribution.

storeFile=/absolute/path/to/heralth-release.keystore
storePassword=CHANGE_ME
keyAlias=heralth
keyPassword=CHANGE_ME
